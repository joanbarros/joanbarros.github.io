---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatPeriod } from "../lib/period";

interface Props {
  entries: CollectionEntry<"timeline">[];
}

const { entries } = Astro.props;
---

<ol class="timeline">
  {
    entries.map(({ data }) => {
      const period = formatPeriod(data.start, data.end);
      return (
        <li class="item">
          <div class="marker" aria-hidden="true">
            {data.logo ? (
              <Image src={data.logo} alt="" width={48} height={48} densities={[1, 2]} />
            ) : (
              <span class="dot" />
            )}
          </div>
          <article class="card">
            {period && <p class="period">{period}</p>}
            <h3>
              {data.url ? (
                <a href={data.url} rel="noopener">
                  {data.org}
                </a>
              ) : (
                data.org
              )}
            </h3>
            {data.role && <p class="role">{data.role}</p>}
            {data.summary && <p class="summary">{data.summary}</p>}
          </article>
        </li>
      );
    })
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 23px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--border);
  }
  .item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 1.25rem;
    position: relative;
  }
  .item + .item {
    margin-top: 1.5rem;
  }
  .marker {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--border);
    display: grid;
    place-items: center;
    overflow: hidden;
    position: relative;
  }
  .marker :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-soft);
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  .period {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  h3 {
    margin: 0.15rem 0 0;
    font-size: 1.1rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .role {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .summary {
    margin: 0.6rem 0 0;
  }
</style>
