---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Timeline from "../components/Timeline.astro";
import Icon from "../components/Icon.astro";
import portrait from "../assets/me.jpg";
import { profile } from "../data/profile";
import { sortTimeline } from "../lib/period";


const entries = sortTimeline(await getCollection("timeline"));
---

<Base>
  <Header slot="header" />

  <section class="hero container" aria-labelledby="hero-title">
    <Image
      class="portrait"
      src={portrait}
      alt={`Portrait of ${profile.name}`}
      width={160}
      height={160}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
    />
    <div>
      <h1 id="hero-title">{profile.name}</h1>
      <p class="headline">{profile.headline}</p>
      <p class="location">{profile.location}</p>
      <ul class="links">
        <li><a href={`mailto:${profile.email}`}><Icon name="email" />Email</a></li>
        {
          profile.links.map((link) => (
            <li>
              <a href={link.href} rel="me noopener">
                {link.icon && <Icon name={link.icon} />}
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="about" class="container block" aria-labelledby="about-title">
    <h2 id="about-title" class="section-title">About</h2>
    {profile.intro.map((paragraph) => <p class="lead">{paragraph}</p>)}
    <h3 class="subhead">Strengths</h3>
    <ul class="skills">
      {profile.strengths.map((item) => <li>{item}</li>)}
    </ul>
    <h3 class="subhead">Technologies</h3>
    <ul class="skills">
      {profile.technologies.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section id="experience" class="container block" aria-labelledby="experience-title">
    <h2 id="experience-title" class="section-title">Experience &amp; education</h2>
    <Timeline entries={entries} />
    <p class="more"><a href="/resume/">View the printable resume</a></p>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-block: 4rem 2rem;
  }
  .portrait {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 4px var(--bg), 0 0 0 7px var(--accent-soft);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    margin: 0;
  }
  .headline {
    margin: 0.25rem 0 0;
    font-size: 1.2rem;
    color: var(--muted);
  }
  .location {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .subhead {
    font-size: 0.95rem;
    margin: 1.75rem 0 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }
  .block {
    padding-block: 2.5rem;
  }
  .lead {
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
  }
  .skills li {
    font-size: 0.85rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .more {
    margin: 2rem 0 0;
  }
  @media (max-width: 34rem) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding-top: 2.5rem;
    }
    .portrait {
      width: 120px;
      height: 120px;
    }
  }
</style>
